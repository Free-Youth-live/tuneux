# ============================================================
# tuneux 忽略规则
# 只提交源码与发布物，本机私有状态一律不入库
# ============================================================

# —— 构建产物（cargo 生成，可随时重建）——
/target/

# —— 隐藏文件/目录（. 开头）——
# 编辑器工具、系统的本地状态/缓存/配置一律不入库
.*
# 例外：.gitignore 本身需要提交
!.gitignore
# 例外：.github 发布构建配置需要提交
!.github/

# —— 本地测试音频 ——
/测试音频/
/test_tone.wav

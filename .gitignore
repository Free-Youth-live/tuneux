# ============================================================
# tuneux 忽略规则
# 只提交源码与发布物，本机私有状态一律不入库
# ============================================================

# —— 构建产物（cargo 生成，可随时重建）——
/target/

# —— 隐藏文件/目录（. 开头）——
# 编辑器工具、系统的本地状态/缓存/配置一律不入库
.*
# 例外：.gitignore 本身需要提交
!.gitignore
# 例外：.github 发布构建配置需要提交
!.github/

# —— 打包实验产物（不入库；测试音频夹具物理隔离在仓库外，无需忽略条目）——
/tuneux-*.zip
/tuneux-*.tar.gz

# —— 发布打包产物（.app，可由 package-macos-app.sh 重建）——
/dist/

docs/
# —— 内部文档误放防护（docs/ 属仓外规划资料目录，不得在仓内出现）——
/docs/
